# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to app code — everything here
# ends up in the client bundle, so only put values safe for a client to see.
# ---------------------------------------------------------------------------

# Rider_backend's base URL. Its routes are at the root (no /api/v1 prefix).
# - Android emulator: http://10.0.2.2:8000
# - Physical device via Expo Go: your machine's LAN IP, e.g. http://192.168.1.9:8000
# - iOS simulator: http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.1.9:8000

# ---------------------------------------------------------------------------
# Native map build only (@rnmapbox/maps) — NOT loaded from .env, NOT read by
# app code, and not an EXPO_PUBLIC_ var. Export it in your shell (or eas.json's
# `env`) before `npx expo prebuild` / `eas build` — Gradle and CocoaPods read
# it directly from the environment to download the native Mapbox SDK. Get one
# at https://console.mapbox.com/account/access-tokens (Create token → tick
# "Downloads:Read" under Secret scopes; do not reuse your public pk.* token).
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.xxxxxxxx
# ---------------------------------------------------------------------------
