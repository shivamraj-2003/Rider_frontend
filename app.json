{
  "expo": {
    "name": "Top Rider",
    "slug": "Rider_frontend",
    "version": "1.0.0",
    "owner": "toprider123",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toprider.app"
    },
    "android": {
      "package": "com.toprider.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Top Rider uses your location to match you with nearby riders and to share your live position while you're online."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Top Rider needs access to your photos to upload your licence and vehicle documents."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2bce7393-8c56-4863-824c-a580333166a7"
      }
    }
  }
}
